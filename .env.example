# Public site URL (no trailing slash). Use the staging URL until DNS cutover.
NEXT_PUBLIC_SITE_URL=https://labb.com
# Set to "true" on staging so Google doesn't index it before launch.
NEXT_PUBLIC_NOINDEX=false

# Signs access cookies (gated content, partner library). 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=

# Lead delivery (Resend: https://resend.com, verify labb.com and add its SPF/DKIM records)
RESEND_API_KEY=
LEAD_TO_EMAIL=kelly.ramsey@labb.com
# Optional: send CPP applications to a different inbox (defaults to LEAD_TO_EMAIL)
CPP_LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=Labb Website <leads@labb.com>
# Optional: also POST every lead as JSON to a CRM / Zapier / Make / Sheets webhook
LEAD_WEBHOOK_URL=

# Partner library password (interim, until LMS sign-in replaces it)
LIBRARY_PASSWORD=

# Analytics (Google Tag Manager container, e.g. GTM-XXXXXXX). Lead submissions push a `generate_lead` event.
NEXT_PUBLIC_GTM_ID=

# Phase 2: Stripe (leave blank until launch; checkout and webhook stay disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRICE_CERT_PRODUCT_UA=
STRIPE_PRICE_CERT_PRODUCT_OR=
STRIPE_PRICE_CERT_PRODUCT_ORF=
STRIPE_PRICE_CERT_SPECIMEN_HAIR=
STRIPE_PRICE_CERT_SOFTWARE_STATION=
STRIPE_PRICE_CERT_SOFTWARE_LABBHR=
STRIPE_PRICE_CERT_CLINIC_OWNERS=
STRIPE_PRICE_CERT_CONSTRUCTION=
STRIPE_PRICE_CERT_MANUFACTURING=
STRIPE_PRICE_CERT_LOGISTICS=
STRIPE_PRICE_CERT_BACKGROUND=
STRIPE_PRICE_CERT_COST=

# Phase 2: Labb learning platform
NEXT_PUBLIC_LMS_URL=
LMS_API_URL=
LMS_API_KEY=
